# Livestream Copilot M0 — local demo environment (no secrets, no real credentials)
# Copy to .env for local development. Never put real tokens here.

NODE_ENV=development
# Demo endpoints (/api/demo/*, /api/*/replay) are enabled only when NODE_ENV != production
# AND DEMO_ENABLED=true. Production refuses them unconditionally.
DEMO_ENABLED=true

# PostgreSQL connection for API + worker + pg-boss (same database).
# Default matches docker-compose.yml service `db`.
DATABASE_URL=postgres://livestream:livestream@localhost:5432/livestream_m0
# Isolated database used by integration tests (created automatically if missing).
TEST_DATABASE_URL=postgres://livestream:livestream@localhost:5432/livestream_m0_test

PORT=3001
# Comma-separated allowed origins for the web client (same-origin in production).
CORS_ORIGINS=http://localhost:5173
# Base URL the browser uses to reach the API (Vite dev proxy or same origin).
VITE_API_BASE_URL=http://localhost:3001
